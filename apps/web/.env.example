# Public (browser-safe): only the backend origin for curl snippets / Live docs links
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Server-only secrets for the Next BFF (/api/studio, /api/data) — never NEXT_PUBLIC_
API_BASE=http://127.0.0.1:8000
STUDIO_API_KEY=dev-studio-key-change-me
DATA_API_KEY=dev-data-key

# Studio requires sign-in (/login) with STUDIO_API_KEY (or SSO when OIDC is configured).
# Optional dedicated signing secret for session cookies (default: derived from STUDIO_API_KEY).
# STUDIO_SESSION_SECRET=
# Local `npm run dev` only: skip the login page. Ignored in production builds.
STUDIO_DEV_AUTOLOGIN=true
# Set only if you serve a production build over plain HTTP (not recommended).
# STUDIO_COOKIE_INSECURE=true
