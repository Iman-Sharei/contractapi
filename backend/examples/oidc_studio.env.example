# Studio enterprise login (Keycloak / Authentik / Okta / Azure AD)
# Keep STUDIO_API_KEY as break-glass for CLI and local scripts.
STUDIO_API_KEY=dev-studio-key-change-me
STUDIO_OIDC_ISSUER=https://keycloak.example.com/realms/contractapi
STUDIO_OIDC_AUDIENCE=contractapi-studio
# Optional override; default discovers jwks_uri from issuer
# STUDIO_OIDC_JWKS_URL=https://keycloak.example.com/realms/contractapi/protocol/openid-connect/certs
# Optional email allowlist
# STUDIO_OIDC_EMAIL_ALLOWLIST=admin@example.com,de@example.com

# Horizontal async writes
REDIS_URL=redis://localhost:6379/0
JOB_QUEUE_ENABLED=true
# Then: contractapi worker
